{
  "name": "kaizen-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm db:generate && pnpm workspace:ensure && next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "format": "prettier --write src messages scripts tests .github prisma/*.ts *.json *.ts *.mjs *.yaml",
    "format:check": "prettier --check src messages scripts tests .github prisma/*.ts *.json *.ts *.mjs *.yaml",
    "lint": "eslint src scripts tests prisma/*.ts eslint.config.mjs next.config.ts prisma.config.ts vitest.config.ts vitest.integration.config.ts vitest.setup.ts --max-warnings=0",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm db:generate && vitest run",
    "test:coverage": "pnpm db:generate && vitest run --coverage",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:ci-scripts": "node --test scripts/validate-governance.test.mjs scripts/validate-data.test.mjs scripts/validate-component-structure.test.mjs scripts/validate-layer-boundaries.test.mjs scripts/validate-ui-icons.test.mjs",
    "governance": "node scripts/validate-governance.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "data:import": "pnpm db:generate && node --conditions=react-server --import tsx scripts/import-versioned-plan-definitions.ts",
    "data:check:persisted": "pnpm db:generate && node --conditions=react-server --import tsx scripts/validate-persisted-data.ts",
    "workspace:ensure": "node --conditions=react-server --import tsx scripts/ensure-fixed-workspace.ts",
    "db:recovery:check": "pnpm db:generate && node --conditions=react-server --import tsx scripts/validate-backup-and-restore.ts",
    "structure:check": "node scripts/validate-component-structure.mjs && node scripts/validate-layer-boundaries.mjs && node scripts/validate-ui-icons.mjs",
    "ci": "pnpm db:validate && pnpm format:check && pnpm lint && pnpm structure:check && pnpm i18n:check && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm test:ci-scripts && pnpm data:check && pnpm build && pnpm audit --audit-level=moderate",
    "i18n:check": "node scripts/validate-i18n.mjs"
  },
  "dependencies": {
    "@fradelli/ui": "0.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
