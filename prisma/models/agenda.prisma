model AgendaTag {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  revision    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  colorKey    String           @map("color_key")
  systemKey   String?          @map("system_key")
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(6)
  activities  AgendaActivity[]

  @@unique([workspaceId, systemKey])
  @@unique([workspaceId, id])
  @@map("agenda_tag")
}

model TodoList {
  systemKey   String?                @map("system_key")
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  revision    Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  colorKey    String?                @map("color_key")
  sortOrder   Int                    @default(0) @map("sort_order")
  archivedAt  DateTime?              @map("archived_at") @db.Timestamptz(6)
  todos       Todo[]
  placements  TodoPlacementVersion[]

  @@unique([workspaceId, systemKey])
  @@unique([workspaceId, id])
  @@map("todo_list")
}

model Todo {
  history          TodoRevision[]
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                 @map("workspace_id") @db.Uuid
  revision         Int                    @default(0)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  listId           String                 @map("list_id") @db.Uuid
  title            String
  estimatedMinutes Int?                   @map("estimated_minutes")
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz(6)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(6)
  list             TodoList               @relation(fields: [workspaceId, listId], references: [workspaceId, id], onDelete: Restrict)
  reservations     TodoReservation[]
  placements       TodoPlacementVersion[]

  @@unique([workspaceId, id])
  @@index([workspaceId, listId, id])
  @@map("todo")
}

model TodoPlacementVersion {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String            @map("workspace_id") @db.Uuid
  revision      Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  todoId        String            @map("todo_id") @db.Uuid
  listId        String            @map("list_id") @db.Uuid
  effectiveFrom DateTime          @map("effective_from") @db.Timestamptz(6)
  colorKey      String?           @map("color_key")
  todo          Todo              @relation(fields: [workspaceId, todoId], references: [workspaceId, id], onDelete: Restrict)
  list          TodoList          @relation(fields: [workspaceId, listId], references: [workspaceId, id], onDelete: Restrict)
  reservations  TodoReservation[]

  @@unique([workspaceId, todoId, id])
  @@unique([workspaceId, todoId, effectiveFrom])
  @@unique([workspaceId, id])
  @@map("todo_placement_version")
}

model AgendaActivity {
  colorKey         String?                  @map("color_key")
  history          AgendaActivityRevision[]
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  revision         Int                      @default(0)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  title            String
  tagId            String?                  @map("tag_id") @db.Uuid
  parentActivityId String?                  @map("parent_activity_id") @db.Uuid
  startsAt         DateTime?                @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?                @map("ends_at") @db.Timestamptz(6)
  scheduledDate    DateTime?                @map("scheduled_date") @db.Date
  removedAt        DateTime?                @map("removed_at") @db.Timestamptz(6)
  tag              AgendaTag?               @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Restrict)
  parent           AgendaActivity?          @relation("AgendaParent", fields: [workspaceId, parentActivityId], references: [workspaceId, id], onDelete: Restrict)
  children         AgendaActivity[]         @relation("AgendaParent")
  reservations     TodoReservation[]

  @@unique([workspaceId, id])
  @@index([workspaceId, parentActivityId, id])
  @@index([workspaceId, scheduledDate, id])
  @@map("agenda_activity")
}

model TodoReservation {
  colorKey           String?                   @map("color_key")
  history            TodoReservationRevision[]
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String                    @map("workspace_id") @db.Uuid
  revision           Int                       @default(0)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  todoId             String                    @map("todo_id") @db.Uuid
  placementVersionId String                    @map("placement_version_id") @db.Uuid
  parentActivityId   String?                   @map("parent_activity_id") @db.Uuid
  startsAt           DateTime                  @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime                  @map("ends_at") @db.Timestamptz(6)
  removedAt          DateTime?                 @map("removed_at") @db.Timestamptz(6)
  todo               Todo                      @relation(fields: [workspaceId, todoId], references: [workspaceId, id], onDelete: Restrict)
  placement          TodoPlacementVersion      @relation(fields: [workspaceId, todoId, placementVersionId], references: [workspaceId, todoId, id], onDelete: Restrict)
  parent             AgendaActivity?           @relation(fields: [workspaceId, parentActivityId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, todoId, startsAt, id])
  @@index([workspaceId, parentActivityId, id])
  @@map("todo_reservation")
}

model AgendaActivityRevision {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  entityId    String         @map("entity_id") @db.Uuid
  revision    Int
  recordedAt  DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  snapshot    Json
  entity      AgendaActivity @relation(fields: [workspaceId, entityId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, entityId, revision])
  @@map("agenda_activity_revision")
}

model TodoRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  entityId    String   @map("entity_id") @db.Uuid
  revision    Int
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  snapshot    Json
  entity      Todo     @relation(fields: [workspaceId, entityId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, entityId, revision])
  @@map("todo_revision")
}

model TodoReservationRevision {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  entityId    String          @map("entity_id") @db.Uuid
  revision    Int
  recordedAt  DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  snapshot    Json
  entity      TodoReservation @relation(fields: [workspaceId, entityId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, entityId, revision])
  @@map("todo_reservation_revision")
}

model AgendaMutationReceipt {
  workspaceId String    @map("workspace_id") @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  commandHash String    @map("command_hash")
  result      Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([workspaceId, operationId])
  @@map("agenda_mutation_receipt")
}
